# DeepSeek API settings. Fill your own key; never share the filled file.
# UI-saved API Key takes precedence. Restart after editing this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
API_TIMEOUT_SECONDS=120
# The installer manages local embeddings and data paths automatically.
