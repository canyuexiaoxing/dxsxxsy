        {
          "id": "K005",
          "title": "五部门警惕招转培、培训贷风险提示",
          "kind": "warning",
          "url": "https://chinajob.mohrss.gov.cn/c/2026-05-18/543038.shtml",
          "location": "风险提示第三项",
          "published_at": "2026-05-18",
          "verified_at": "2026-10-03",
          "text": "求职者面对求职过程中以各种理由要求参加需支付高额费用的培训，才能够安排岗位的情况，应果断拒绝。确有需求参加培训的，应核实培训机构是否具备依法审批的许可资质，是否含有不合理收费项目、贷款内容。",
          "scope": "求职被转向收费培训及培训贷款风险。",
          "boundary": "官方风险提示不是违法认定；结合招聘、培训、贷款主体及协议分析。",
          "tags": [
            "招转培",
            "培训贷",
            "贷款",
            "高额培训费",
            "包就业",
            "先培训后入职"
          ],
          "stage_scope": "pre",
          "employment_stages": [
            "preemployment"
          ],
          "risk_topics": [
            "fees",
            "training_loan"
          ],
          "classification_reason": "招聘告知、收费扣证或官方求职预防提示",
